# Streamlit 공식 인증(OIDC) 설정 예시 (Google 로그인 기준)
# 실제 사용 시 이 파일을 복사하여 secrets.toml로 이름을 변경한 뒤 본인의 키 정보를 입력하세요.

[auth]
# 로컬 개발 환경 기본 콜백 주소 (포트 변경 시 포트 번호 수정 필요)
redirect_uri = "http://localhost:8501/oauth2callback"

# 브라우저 쿠키 암호화를 위한 임의의 무작위 문자열 (충분히 긴 문자열 권장)
cookie_secret = "your-random-secret-key"

# Google Cloud Console 등에서 발급받은 OIDC Client ID
client_id = "your-client-id.apps.googleusercontent.com"

# 발급받은 OIDC Client Secret
client_secret = "your-client-secret"

# OIDC 공급자의 메타데이터 URL (Google 기준)
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

